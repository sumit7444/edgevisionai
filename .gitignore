# ============================================================
# EdgeVisionAI - Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs / temporary files
*.log
logs/
error.log
*.tmp
*.temp
*.bak

# Database
*.db
*.sqlite
*.sqlite3

# Node / Frontend
node_modules/
dist/
build/
coverage/

# ============================================================
# DATASETS
# ============================================================

/datasets/
data/raw/

# Generated/processed datasets
data/processed/dataset1/
data/processed/dataset2/
data/processed/final/
data/processed/final_before_id_fix/

# Dataset images and labels
data/processed/*/images/
data/processed/*/labels/

# Dataset caches
*.cache
data/annotations/*.cache

# ============================================================
# YOLO / ULTRALYTICS
# ============================================================

*.pt
*.pth
*.onnx
*.engine
*.tflite
*.torchscript

weights/
models/
runs/
predictions/
inference_results/

# TensorBoard
runs/*/events.out.tfevents.*

# ============================================================
# Training / generated files
# ============================================================

training/dataset/
training/runs/
training/cache/
training/**/*.cache

# ============================================================
# Snapshots / uploads
# ============================================================

snapshots/*
!snapshots/.gitkeep

uploads/*
!uploads/.gitkeep

# ============================================================
# KEEP PROJECT SOURCE / CONFIGURATION
# ============================================================

!data/processed/*.py
!data/datasets/*.yaml
!data/datasets/*.yml
!data/datasets/*.md