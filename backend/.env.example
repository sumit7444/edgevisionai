# Database (Neon PostgreSQL or local SQLite)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI / ML YOLO Engine Configuration
MODEL_PATH=best.pt
MODEL_VERSION=v1.2.0-yolov8-industrial
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
NMS_THRESHOLD=0.50
DEVICE=auto

# Web & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
SNAPSHOT_DIR=snapshots

# JWT Authentication & Security
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Safety Rules Thresholds
PROXIMITY_THRESHOLD=0.12
FALL_ASPECT_RATIO_THRESHOLD=0.75
VIOLATION_COOLDOWN_SECONDS=8
